        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (tool_name) (tool_calls_total)",
          "legendFormat": "{{tool_name}}",
          "refId": "A"
