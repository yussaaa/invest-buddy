# ─────────────────────────────────────────────
# MODEL PROVIDER  (openai | anthropic | qwen | ollama | vllm)
# ─────────────────────────────────────────────
MODEL_PROVIDER=openai

# OpenAI (default)
OPENAI_API_KEY=sk-...
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_SMART_MODEL=gpt-4o

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_SMART_MODEL=claude-sonnet-4-6

# Qwen via DashScope
DASHSCOPE_API_KEY=sk-...
QWEN_FAST_MODEL=qwen2.5-7b-instruct
QWEN_SMART_MODEL=qwen2.5-72b-instruct

# Ollama (local — zero cost, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=qwen2.5:7b
OLLAMA_SMART_MODEL=qwen2.5:14b

# vLLM (local GPU)
VLLM_BASE_URL=http://localhost:8000
VLLM_FAST_MODEL=Qwen2.5-7B-Instruct
VLLM_SMART_MODEL=Qwen2.5-72B-Instruct

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agent_invest:password@localhost:5432/agent_invest

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────
# QDRANT (vector store)
# ─────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=financial_documents

# ─────────────────────────────────────────────
# EXTERNAL DATA APIS
# ─────────────────────────────────────────────
NEWSAPI_KEY=your_newsapi_key
TAVILY_API_KEY=tvly-...
ALPHA_VANTAGE_KEY=your_alpha_vantage_key    # optional, yfinance is default

# ─────────────────────────────────────────────
# MONITORING (mlflow | wandb)
# ─────────────────────────────────────────────
MONITORING_BACKEND=mlflow
MLFLOW_TRACKING_URI=http://localhost:5050
WANDB_API_KEY=your_wandb_key
WANDB_PROJECT=agent-invest

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
APP_ENV=development         # development | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=change-me-in-production
